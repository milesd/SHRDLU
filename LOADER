;
; This file loads in all the needed files for SHRDLU.
;

; This appears to be the width of the terminal
; No, it's not.  Not sure what it is....
(DEFCONSTANT CHRCT 76)

(load "fixes")
(load "progmr")
(load "cgram")
(load "syscom")
(load "smutil")
(load "smspec")
(load "smass")
(load "dictio")
(load "morpho")
(load "show")
(load "blockl")
(load "plnr")
(load "setup")
(load "thtrac")
(load "blockp")
(load "data")
(load "newans")
(load "mover")
(load "regis")

; Set either (DEBUGMODE) or (USERMODE) here.
(USERMODE)
;(DEBUGMODE)

; Suppress load messages
(setq *load-verbose* nil)
; Use wireframe rendering, no shading
; (setq *wireframe* t)
; Sleep between each interpolated frame. 0.06s (~16fps), 0.2 = slow-motion
(setq *frame-delay* 0.10)

; Start the program
(INITIALSTUFF 'REGIS-1.0 NIL)

