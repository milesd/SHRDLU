; SIXEL -- isometric wireframe renderer with animated crane arm for SHRDLU
;
; Renders the blocks world as a Sixel image in a Sixel-capable terminal
; (iTerm2 with Sixel enabled, WezTerm, xterm -ti vt340, foot, mlterm, etc.)
;
; Rendering:
;   Wireframe isometric projection — blocks and BOX drawn as edges only
;   (Bresenham lines), floor drawn as outline + sparse grid.  The crane arm
;   is a vertical cable from overhead (wz=750) to HANDAT, with a small claw.
;
; Isometric projection (viewer at front-right-above):
;   screen_x =  (wx - wy) * ISO-SX + OX
;   screen_y = -(wx + wy) * ISO-SY - wz * ISO-SZ + OY   (OY near bottom)
;
; Canvas: *pw* x *ph* px.  World content spans ~528px wide; *pw*=600 leaves
; 36px margins.  *ph* must be a multiple of 6 (Sixel band height).
; After changing *ph*, update *text-row*: ≈ ceil(*ph* / line_px) + 2.
;
; Animation:
;   ANSWER is wrapped to snapshot ATABLE before the planning pass so blocks
;   render at their pre-move positions during execution.  Each MOVETO call
;   interpolates the arm over *anim-frames* steps.  When carrying a block,
;   the arm follows an arc peaking at max(from-z, to-z, *carry-clearance*)
;   so the block clears obstacles regardless of what the planner computed.
;   The carried block rides below the arm tip (arm-z minus block height).
;   UNGRASP renders one final frame showing the block at its placed position.
;
; Tuning knobs (setq at runtime or edit here):
;   *anim-frames*     — steps per MOVETO (default 6, ~1.4s at 4fps)
;   *carry-clearance* — minimum arc peak z when carrying (default 700)
;   *text-row*        — first row of scrolling text area (default 17)
;   *render-timing*   — set T to print per-phase ms to stderr
;
; Projection scale knobs (change the look without resizing):
;   *iso-sz* — taller blocks, same floor footprint
;   *iso-sy* — more visible floor, same block height
;   *iso-sx* — wider scene, no height change

(defvar *pw*      600)   ; pixel canvas width  (world content spans ~528px; 36px margins)
(defvar *ph*      360)   ; pixel canvas height (must be multiple of 6)
(defvar *iso-sx* 0.24)   ; (wx-wy) multiplier → screen x
(defvar *iso-sy* 0.12)   ; (wx+wy) multiplier → screen y (up)
(defvar *iso-sz* 0.206)  ; wz multiplier       → screen y (up)
(defvar *iso-ox* 300)    ; screen x origin (horizontal center of 600px canvas)
(defvar *iso-oy* 355)    ; screen y origin (near bottom)

(defvar *last-action*       "")
(defvar *last-handat*       nil)  ; arm pos as of last rendered frame (nil = use handat)
(defvar *render-overrides*  nil)  ; alist (name . pos) overriding ATABLE during animation
(defvar *atable-snapshot*   nil)  ; alist (name . pos) saved before planning changes ATABLE
(defvar *carried-block*     nil)  ; name of block currently grasped by the arm
(defvar *anim-frames*       6)    ; interpolation steps per arm movement
(defvar *carry-clearance* 700)    ; minimum peak z when carrying a block (arc trajectory)

; ANSI color helpers for status line and scrolling text output.
; Pre-computed at load time so format in hot paths stays simple.
(let ((e (code-char 27)))
  (defvar *c-reset*   (format nil "~c[0m"  e))
  (defvar *c-green*   (format nil "~c[32m" e))   ; placed (execution)
  (defvar *c-yellow*  (format nil "~c[33m" e))   ; planned / choosing
  (defvar *c-cyan*    (format nil "~c[36m" e))   ; hand movement
  (defvar *c-magenta* (format nil "~c[35m" e))   ; grasp
  (defvar *c-dim*     (format nil "~c[2m"  e)))  ; release

; -- color palette: (r g b) each 0-100 percent --
; 0=canvas bg, 1=floor, then top/front/right per named color

(defvar *sixel-palette*
  #((8   8  10)    ;  0 canvas background (near-black)
    (22  22  18)   ;  1 floor grid         (dim warm gray)
    (100 25  25)   ;  2 RED   top
    (75  15  15)   ;  3 RED   front
    (55  10  10)   ;  4 RED   right
    (25 100  25)   ;  5 GREEN top
    (15  75  15)   ;  6 GREEN front
    (10  55  10)   ;  7 GREEN right
    (25  25 100)   ;  8 BLUE  top
    (15  15  75)   ;  9 BLUE  front
    (10  10  55)   ; 10 BLUE  right
    (95  95  95)   ; 11 WHITE top
    (70  70  70)   ; 12 WHITE front
    (50  50  50)   ; 13 WHITE right
    (100 65  15)   ; 14 ORANGE top
    (75  50  10)   ; 15 ORANGE front
    (55  35   8)   ; 16 ORANGE right
    (55 100  55)   ; 17 crane arm (phosphor green)
    ))

(defun color-indices (sym)
  (cond ((eq sym 'RED)    '(2  3  4))
        ((eq sym 'GREEN)  '(5  6  7))
        ((eq sym 'BLUE)   '(8  9  10))
        ((eq sym 'WHITE)  '(11 12 13))
        ((eq sym 'ORANGE) '(14 15 16))
        (t                '(11 12 13))))

; -- world-state helpers --

(defun sixel-skip-p (name)
  (member name '(:TABLE :BW1 :BW2 :BW3 :BW4 :HAND)))

(defun sixel-color (name)
  (let ((e (assoc name display-as)))
    (when e (nth 5 e))))

(defun sixel-shape (name)
  (let ((e (assoc name display-as)))
    (when e (caddr e))))

(defun sixel-display-size (name)
  ; display-as entry: (name #DISPLAY shape pos size color)
  (let ((e (assoc name display-as)))
    (when e (nth 4 e))))

; -- isometric projection --

(defun iso-pt (wx wy wz)
  (cons (round (+ *iso-ox* (* (- wx wy) *iso-sx*)))
        (round (- *iso-oy* (* (+ wx wy) *iso-sy*) (* wz *iso-sz*)))))

; -- pixel buffer --

(defun make-pbuf ()
  (make-array (list *ph* *pw*) :initial-element 0))

(defun pbuf-set (buf x y ci)
  (when (and (>= x 0) (< x *pw*) (>= y 0) (< y *ph*))
    (setf (aref buf y x) ci)))

; -- scanline polygon fill --

(defun fill-poly (buf pts ci)
  (when (< (length pts) 3) (return-from fill-poly))
  (let* ((ys (mapcar #'cdr pts))
         (y1 (max 0          (apply #'min ys)))
         (y2 (min (1- *ph*)  (apply #'max ys)))
         (n  (length pts)))
    (loop for y from y1 to y2 do
      (let (xs)
        (dotimes (i n)
          (let* ((a  (nth i pts))
                 (b  (nth (mod (1+ i) n) pts))
                 (ay (cdr a)) (by (cdr b))
                 (ax (car a)) (bx (car b)))
            (when (or (and (<= ay y) (< y by))
                      (and (<= by y) (< y ay)))
              (let ((frac (/ (float (- y ay)) (- by ay))))
                (push (round (+ ax (* frac (- bx ax)))) xs)))))
        (when (>= (length xs) 2)
          (loop for x from (max 0         (apply #'min xs))
                        to (min (1- *pw*) (apply #'max xs)) do
            (pbuf-set buf x y ci)))))))

; -- background and floor --

(defun fill-background (buf)
  (fill (make-array (* *ph* *pw*) :displaced-to buf) 0))

(defun draw-floor (buf)
  ; outline + sparse grid at z=0
  (flet ((ln (ax ay bx by)
           (let ((a (iso-pt ax ay 0)) (b (iso-pt bx by 0)))
             (draw-line buf (car a) (cdr a) (car b) (cdr b) 1))))
    ; outline
    (ln    0    0 1100    0)
    (ln 1100    0 1100 1100)
    (ln 1100 1100    0 1100)
    (ln    0 1100    0    0)
    ; grid lines every 275 units
    (loop for g in '(275 550 825) do
      (ln g    0 g 1100)
      (ln 0    g 1100 g))))

; -- isometric block drawing --
;
; Wireframe: draw the 9 visible edges of the block.
; Viewer at small wx, small wy, large wz — visible edges are:
;   3 vertical pillars: near (p000-p001), far-left (p010-p011), far-right (p100-p101)
;   4 top diamond edges: p001-p101, p101-p111, p111-p011, p011-p001
;   2 bottom near edges: p000-p010, p000-p100

(defun draw-block-iso (buf wx1 wy1 wz1 wx2 wy2 wz2 color-sym)
  (let ((ci  (first (color-indices color-sym)))
        (p000 (iso-pt wx1 wy1 wz1))
        (p100 (iso-pt wx2 wy1 wz1))
        (p010 (iso-pt wx1 wy2 wz1))
        (p001 (iso-pt wx1 wy1 wz2))
        (p101 (iso-pt wx2 wy1 wz2))
        (p011 (iso-pt wx1 wy2 wz2))
        (p111 (iso-pt wx2 wy2 wz2)))
    (flet ((ln (a b) (draw-line buf (car a) (cdr a) (car b) (cdr b) ci)))
      (ln p000 p001)  ; near vertical
      (ln p010 p011)  ; far-left vertical
      (ln p100 p101)  ; far-right vertical
      (ln p001 p101)  ; top front edge
      (ln p101 p111)  ; top right edge
      (ln p111 p011)  ; top back edge
      (ln p011 p001)  ; top left edge
      (ln p000 p010)  ; bottom left edge
      (ln p000 p100)  ; bottom front edge
    )))

; -- Bresenham line --

(defun draw-line (buf x0 y0 x1 y1 ci)
  (let* ((dx (abs (- x1 x0))) (dy (abs (- y1 y0)))
         (sx (if (< x0 x1) 1 -1)) (sy (if (< y0 y1) 1 -1))
         (err (- dx dy)))
    (loop
      (pbuf-set buf x0 y0 ci)
      (when (and (= x0 x1) (= y0 y1)) (return))
      (let ((e2 (* 2 err)))
        (when (> e2 (- dy)) (incf err (- dy)) (incf x0 sx))
        (when (< e2 dx)     (incf err dx)     (incf y0 sy))))))

; -- isometric box wireframe (split for correct occlusion) --
;
; Back edges (high wx or wy) drawn before inside objects so they can be overdrawn.
; Front edges (low wx/wy) drawn after inside objects so they always appear in front.

(defun draw-box-back-edges (buf wx1 wy1 wz1 wx2 wy2 wz2 color-sym)
  (let ((ci (first (color-indices color-sym)))
        (p100 (iso-pt wx2 wy1 wz1))
        (p010 (iso-pt wx1 wy2 wz1))
        (p101 (iso-pt wx2 wy1 wz2))
        (p011 (iso-pt wx1 wy2 wz2))
        (p111 (iso-pt wx2 wy2 wz2)))
    (flet ((ln (a b)
             (draw-line buf (car a) (cdr a) (car b) (cdr b) ci)))
      (ln p100 p101)   ; vertical: front-right corner (high wx)
      (ln p010 p011)   ; vertical: back-left corner  (high wy)
      (ln p101 p111)   ; top: right edge
      (ln p011 p111)   ; top: back edge
      )))

(defun draw-box-front-edges (buf wx1 wy1 wz1 wx2 wy2 wz2 color-sym)
  (let ((ci (first (color-indices color-sym)))
        (p000 (iso-pt wx1 wy1 wz1))
        (p100 (iso-pt wx2 wy1 wz1))
        (p010 (iso-pt wx1 wy2 wz1))
        (p001 (iso-pt wx1 wy1 wz2))
        (p101 (iso-pt wx2 wy1 wz2))
        (p011 (iso-pt wx1 wy2 wz2)))
    (flet ((ln (a b)
             (draw-line buf (car a) (cdr a) (car b) (cdr b) ci)))
      (ln p000 p001)   ; vertical: front-left corner (low wx, low wy)
      (ln p000 p100)   ; bottom: front edge
      (ln p000 p010)   ; bottom: left edge
      (ln p001 p101)   ; top: front edge
      (ln p001 p011)   ; top: left edge
      )))

; -- isometric pyramid drawing --
;
; Square base at wz1, apex at center of base footprint at wz2.
; Visible faces from this viewpoint:
;   x-min triangle: p000, p010, apex  (left face,  medium shade)
;   y-min triangle: p000, p100, apex  (front face, dark shade)

(defun draw-pyramid-iso (buf wx1 wy1 wz1 wx2 wy2 wz2 color-sym)
  (destructuring-bind (ci-t ci-l ci-r) (color-indices color-sym)
    (declare (ignore ci-t))
    (let* ((wmx (/ (+ wx1 wx2) 2.0))
           (wmy (/ (+ wy1 wy2) 2.0))
           (p000 (iso-pt wx1 wy1 wz1))
           (p100 (iso-pt wx2 wy1 wz1))
           (p010 (iso-pt wx1 wy2 wz1))
           (apex (iso-pt wmx wmy wz2)))
      (fill-poly buf (list p000 p010 apex) ci-l)  ; left  face (x-min)
      (fill-poly buf (list p000 p100 apex) ci-r)  ; front face (y-min)
      )))

; -- crane arm --
;
; Vertical cable from overhead (wz=750) straight down to HANDAT.
; The trolley rides at the same wx,wy as the hand; a small claw marks the tip.

(defun draw-crane-arm (buf)
  (let* ((hpos (or (cdr (assoc :hand *render-overrides*)) handat))
         (hx  (car   hpos))
         (hy  (cadr  hpos))
         (hz  (caddr hpos))
         (ci  17)                              ; phosphor green
         (top (iso-pt hx hy 750))
         (tip (iso-pt hx hy hz))
         (tx  (car top)) (ty (cdr top))
         (bx  (car tip)) (by (cdr tip)))
    (draw-line buf tx ty bx by ci)            ; cable
    (draw-line buf (- bx 5) (- by 3) bx by ci)  ; claw left tine
    (draw-line buf (+ bx 5) (- by 3) bx by ci)  ; claw right tine
    ))

; -- Sixel encoder --
;
; Single-pass accumulation: one scan over each band's pixels sets bits in a
; flat (nc × pw) byte array.  Output is built into a string stream and flushed
; in one write, avoiding per-character stdout overhead.

(defun emit-sixel (buf)
  (let* ((esc   (code-char 27))
         (nc    (length *sixel-palette*))
         (bands (/ *ph* 6))
         ; flat array: index = ci * *pw* + x  →  sixel bits for color ci at column x
         (rows  (make-array (* nc *pw*) :element-type '(unsigned-byte 8) :initial-element 0))
         (used  (make-array nc          :element-type 'bit               :initial-element 0))
         (out   (make-string-output-stream)))
    ; DCS header + raster attributes
    (write-char esc out) (write-string "P0;0;0q" out)
    (format out "\"1;1;~a;~a" *pw* *ph*)
    ; palette
    (loop for i from 0 below nc do
      (let ((c (aref *sixel-palette* i)))
        (write-char #\# out) (princ i out) (write-string ";2;" out)
        (princ (first c) out) (write-char #\; out)
        (princ (second c) out) (write-char #\; out)
        (princ (third c) out)))
    ; bands
    (loop for band from 0 below bands do
      (let ((y0 (* band 6)))
        ; clear per-band state
        (fill rows 0)
        (fill used 0)
        ; single pass: accumulate sixel bits for every color simultaneously
        (loop for dy from 0 below 6 do
          (let ((bit (ash 1 dy))
                (y   (+ y0 dy)))
            (loop for x from 0 below *pw* do
              (let* ((ci  (aref buf y x))
                     (idx (+ (* ci *pw*) x)))
                (setf (aref rows idx) (logior (aref rows idx) bit))
                (setf (aref used ci) 1)))))
        ; emit each used color's row
        (let ((first-p t))
          (loop for ci from 0 below nc do
            (when (= 1 (aref used ci))
              (unless first-p (write-char #\$ out))
              (setq first-p nil)
              (write-char #\# out) (princ ci out)
              (let* ((base    (* ci *pw*))
                     (run-ch  (+ 63 (aref rows base)))
                     (run-len 1))
                (flet ((flush ()
                         (if (> run-len 3)
                             (progn (write-char #\! out)
                                    (princ run-len out)
                                    (write-char (code-char run-ch) out))
                             (loop repeat run-len
                                   do (write-char (code-char run-ch) out)))))
                  (loop for x from 1 below *pw* do
                    (let ((ch (+ 63 (aref rows (+ base x)))))
                      (if (= ch run-ch)
                          (incf run-len)
                          (progn (flush) (setq run-ch ch run-len 1)))))
                  (flush))))))
        (write-char #\- out)))
    ; string terminator, then single flush to stdout
    (write-char esc out) (write-char #\\ out)
    (write-string (get-output-stream-string out))
    (finish-output)))

; -- animation helpers --

(defun lerp-pos (p1 p2 alpha)
  (list (round (+ (car   p1) (* alpha (- (car   p2) (car   p1)))))
        (round (+ (cadr  p1) (* alpha (- (cadr  p2) (cadr  p1)))))
        (round (+ (caddr p1) (* alpha (- (caddr p2) (caddr p1)))))))

; -- MOVER intercepts --

(let ((orig-moveto  (symbol-function 'moveto))
      (orig-grasp   (symbol-function 'grasp))
      (orig-ungrasp (symbol-function 'ungrasp))
      (orig-blink   (symbol-function 'blink)))
  (defun moveto (x y z)
    (setq *last-action* (format nil "~amoving hand to (~a ~a ~a)~a" *c-cyan* x y z *c-reset*))
    (let* ((from  (or *last-handat* handat))
           (to    (list x y z))
           (block *carried-block*)
           (bdz   (when block (caddr (caddr (atab block)))))
           (n     *anim-frames*))
      (dotimes (i n)
        (let* ((alpha (/ (float (1+ i)) n))
               (lpos  (lerp-pos from to alpha))
               (hpos  (if block
                          ; arc: z peaks at max(from-z, to-z, clearance) via sine blend
                          (let* ((peak (float (max (caddr from) (caddr to) *carry-clearance*)))
                                 (lz   (float (caddr lpos)))
                                 (s    (sin (* pi alpha))))
                            (list (car lpos) (cadr lpos)
                                  (round (+ (* (- 1.0 s) lz) (* s peak)))))
                          lpos)))
          (setq *render-overrides*
                (if block
                    (list (cons :hand hpos)
                          (cons block (list (car hpos) (cadr hpos) (- (caddr hpos) bdz))))
                    (list (cons :hand hpos))))
          (render-world)))
      (setq *render-overrides* nil
            *last-handat*      to))
    (funcall orig-moveto x y z))
  (defun grasp (x)
    (setq *last-action*   (format nil "~agrasping ~a~a" *c-magenta* x *c-reset*)
          *carried-block* x)
    (funcall orig-grasp x))
  (defun ungrasp ()
    (setq *last-action* (format nil "~aletting go~a" *c-dim* *c-reset*))
    (when *carried-block*
      (setq *atable-snapshot*
            (remove *carried-block* *atable-snapshot* :key #'car)
            *carried-block* nil))
    (funcall orig-ungrasp)
    (render-world))
  (defun blink (x)
    (setq *last-action* (format nil "~achoosing ~a~a" *c-yellow* x *c-reset*))
    (funcall orig-blink x)))

; seed *last-handat* from initial HANDAT so the first MOVETO has a valid "from"
(setq *last-handat* (copy-list handat))

; wrap ANSWER to snapshot ATABLE before ANSCOMMAND's THVAL2 planning pass
; changes it, and clear it after EVLIS execution finishes.
; Guard against re-entry (e.g. if GOAL is also called from some path).
(let ((orig-answer (symbol-function 'answer)))
  (defun answer (node)
    (let ((already *atable-snapshot*))
      (unless already
        (setq *atable-snapshot*
              (mapcar (lambda (e) (cons (car e) (copy-list (cadr e)))) atable)))
      (unwind-protect
          (funcall orig-answer node)
        (unless already
          (setq *atable-snapshot* nil))))))

; -- TA-AT patch: render after each block position commit --
;
; BLOCKP's TA-AT theorem fires THRPLACA to update ATABLE whenever the Planner
; asserts a new #AT position. We replace it here (SIXEL loads after BLOCKP) to
; render one frame per physical placement. The trailing T ensures the theorem
; still succeeds regardless of what render-world returns.

(setf (get 'ta-at 'theorem)
  '(thante (x y) (\#at (thv x) (thv y))
    (thrplaca (cdr (atab (thv x))) (thv y))
    t))

; -- terminal layout --
;
; The screen is split into two regions:
;   rows 1 .. (*text-row* - 2)  : Sixel image (not scrolling)
;   row  (*text-row* - 1)       : status line (fixed, separates image from text)
;   rows *text-row* .. bottom   : scrolling text area for SHRDLU I/O
;
; *text-row* is the first row of the scrolling text area.  Tune it to match
; your terminal font size: image is *ph* px, so *text-row* ≈ ceil(*ph* / line_px) + 2.
; With *ph*=240: at ~14px/line use 19; at ~16px/line use 17; at ~18px/line use 15.

(defvar *text-row* 17)

(defun sixel-init ()
  (let ((esc (code-char 27)))
    (format t "~c[?1049h"     esc)              ; enter alternate screen
    (format t "~c[2J"         esc)              ; clear screen
    (format t "~c[~a;r"       esc *text-row*)   ; scrolling region: *text-row* to bottom
    (format t "~c[?25l"       esc)              ; hide cursor
    (format t "~c[~a;1H"      esc *text-row*))  ; cursor to text area
  (finish-output))

(defun sixel-cleanup ()
  (let ((esc (code-char 27)))
    (format t "~c[?25h"   esc)   ; show cursor
    (format t "~c[r"      esc)   ; reset scroll region
    (format t "~c[?1049l" esc))  ; leave alternate screen
  (finish-output))

; -- main entry point --

(defvar *render-timing* nil)   ; set T to print per-phase timings

(defmacro timed (label &body body)
  `(let* ((.t0. (get-internal-real-time))
          (.r.  (progn ,@body))
          (.ms. (round (* 1000 (/ (- (get-internal-real-time) .t0.)
                                  internal-time-units-per-second)))))
     (when *render-timing*
       (format *error-output* "~a: ~ams~%" ,label .ms.))
     .r.))

(defun render-world ()
  (let ((buf  (timed "alloc+clear" (make-pbuf)))
        (esc  (code-char 27)))
    (timed "fill-background" (fill-background buf))
    (timed "draw-floor"      (draw-floor buf))
    ; Build a single sorted draw list.  BOX back/front edges are injected at
    ; their natural depth positions rather than forced to first/last pass.
    ;   back edges  → key of BOX far corner  (wx2+wy2-wz1): drawn behind everything inside
    ;   front edges → key of BOX near corner (wx1+wy1-wz1): drawn after inside objects,
    ;                 before objects closer to the viewer than the BOX face
    (timed "draw-objects"
      (let ((ops '()))
        (dolist (entry atable)
          (let* ((name (car  entry))
                 (pos  (or (cdr (assoc name *render-overrides*))
                           (cdr (assoc name *atable-snapshot*))
                           (cadr entry)))
                 (size (caddr entry))
                 (wx1 (car pos)) (wy1 (cadr pos)) (wz1 (caddr pos)))
            (cond
              ((eq (sixel-shape name) '\#BOX)
               (let* ((ds    (or (sixel-display-size name) size))
                      (wx2   (+ wx1 (car ds)))
                      (wy2   (+ wy1 (cadr ds)))
                      (wz2   (+ wz1 (caddr ds)))
                      (color (or (sixel-color name) 'WHITE)))
                 (push (list (- (+ wx2 wy2) wz1) '\#back  wx1 wy1 wz1 wx2 wy2 wz2 color) ops)
                 (push (list (- (+ wx1 wy1) wz1) '\#front wx1 wy1 wz1 wx2 wy2 wz2 color) ops)))
              ((not (sixel-skip-p name))
               (let* ((shape (sixel-shape name))
                      (color (or (sixel-color name) 'WHITE))
                      (wx2   (+ wx1 (car   size)))
                      (wy2   (+ wy1 (cadr  size)))
                      (wz2   (+ wz1 (caddr size)))
                      (key   (- (+ wx1 wy1) wz1)))
                 (push (list key shape wx1 wy1 wz1 wx2 wy2 wz2 color) ops))))))
        (dolist (op (sort ops #'> :key #'car))
          (destructuring-bind (key shape wx1 wy1 wz1 wx2 wy2 wz2 color) op
            (declare (ignore key))
            (cond
              ((eq shape '\#back)    (draw-box-back-edges  buf wx1 wy1 wz1 wx2 wy2 wz2 color))
              ((eq shape '\#front)   (draw-box-front-edges buf wx1 wy1 wz1 wx2 wy2 wz2 color))
              ((eq shape '\#PYRAMID) (draw-pyramid-iso     buf wx1 wy1 wz1 wx2 wy2 wz2 color))
              (t                     (draw-block-iso       buf wx1 wy1 wz1 wx2 wy2 wz2 color))))))
      (draw-crane-arm buf))
    ; save cursor position in text area, draw image atomically, restore
    (format t "~c7"           esc)              ; DECSC: save cursor
    (format t "~c[?2026h"     esc)              ; begin synchronized update
    (format t "~c[1;1H"       esc)              ; go to top-left (image area)
    (timed "emit-sixel" (emit-sixel buf))
    ; status line: fixed row just above text area, cleared to EOL
    (format t "~c[~a;1H~a~c[K" esc (1- *text-row*) *last-action* esc)
    (format t "~c[?2026l"     esc)              ; flush atomically
    (format t "~c8"           esc))             ; DECRC: restore cursor to text area
  (finish-output))

(defun benchmark-render (&optional (n 20) (delay-ms 100))
  "Render N frames, sleeping DELAY-MS between each. Report throughput (excludes sleep time)."
  (let* ((render-ms 0)
         (units     internal-time-units-per-second)
         (delay-s   (/ delay-ms 1000.0)))
    (dotimes (i n)
      (let ((t0 (get-internal-real-time)))
        (render-world)
        (incf render-ms (round (* 1000 (/ (- (get-internal-real-time) t0) units))))
        (when (< i (1- n)) (sleep delay-s))))
    (let ((per-frame (round (/ render-ms n))))
      (format *error-output* "~&benchmark: ~a frames, ~ams render total (~ams/frame, ~afps excl. sleep)~%"
              n render-ms per-frame (round (/ 1000 (max 1 per-frame))))
      (finish-output *error-output*)
      (values render-ms per-frame))))

(setq *render-timing* t)
(benchmark-render 5 0)
(setq *render-timing* nil)
(sixel-init)
(render-world)
(let ((hooks (find-symbol "*EXIT-HOOKS*" (find-package "EXT"))))
  (when hooks (pushnew #'sixel-cleanup (symbol-value hooks))))
