; SIXEL -- isometric pixel renderer for SHRDLU blocks world
;
; Requires Sixel-capable terminal (iTerm2 with Sixel enabled, WezTerm,
; xterm -ti vt340, foot, mlterm, etc.)
;
; Isometric projection (viewer at front-right-above):
;   screen_x =  (wx - wy) * ISO-SX + OX
;   screen_y = -(wx + wy) * ISO-SY - wz * ISO-SZ + OY   (OY near bottom)
;
; World bounding box: X 0-976, Y 0-976, Z 0-~500.
; Canvas sized so the full world fits with margins.

(defvar *pw*     1600)   ; pixel canvas width
(defvar *ph*     1020)   ; pixel canvas height (must be multiple of 6)
(defvar *iso-sx* 0.35)   ; (wx-wy) multiplier → screen x
(defvar *iso-sy* 0.175)  ; (wx+wy) multiplier → screen y (up)
(defvar *iso-sz* 0.30)   ; wz multiplier       → screen y (up)
(defvar *iso-ox* 800)    ; screen x origin (horizontal center)
(defvar *iso-oy* 1000)   ; screen y origin (near bottom)

(defvar *last-action* "")

; -- color palette: (r g b) each 0-100 percent --
; 0=canvas bg, 1=floor, then top/front/right per named color

(defvar *sixel-palette*
  #((8   8  10)    ;  0 canvas background (near-black)
    (20  18  15)   ;  1 floor              (dark warm gray)
    (100 25  25)   ;  2 RED   top
    (75  15  15)   ;  3 RED   front
    (55  10  10)   ;  4 RED   right
    (25 100  25)   ;  5 GREEN top
    (15  75  15)   ;  6 GREEN front
    (10  55  10)   ;  7 GREEN right
    (25  25 100)   ;  8 BLUE  top
    (15  15  75)   ;  9 BLUE  front
    (10  10  55)   ; 10 BLUE  right
    (95  95  95)   ; 11 WHITE top
    (70  70  70)   ; 12 WHITE front
    (50  50  50)   ; 13 WHITE right
    (100 65  15)   ; 14 ORANGE top
    (75  50  10)   ; 15 ORANGE front
    (55  35   8)   ; 16 ORANGE right
    ))

(defun color-indices (sym)
  (cond ((eq sym 'RED)    '(2  3  4))
        ((eq sym 'GREEN)  '(5  6  7))
        ((eq sym 'BLUE)   '(8  9  10))
        ((eq sym 'WHITE)  '(11 12 13))
        ((eq sym 'ORANGE) '(14 15 16))
        (t                '(11 12 13))))

; -- world-state helpers --

(defun sixel-skip-p (name)
  (member name '(:TABLE :BW1 :BW2 :BW3 :BW4 :HAND)))

(defun sixel-color (name)
  (let ((e (assoc name display-as)))
    (when e (nth 5 e))))

(defun sixel-shape (name)
  (let ((e (assoc name display-as)))
    (when e (caddr e))))

; -- isometric projection --

(defun iso-pt (wx wy wz)
  (cons (round (+ *iso-ox* (* (- wx wy) *iso-sx*)))
        (round (- *iso-oy* (* (+ wx wy) *iso-sy*) (* wz *iso-sz*)))))

; -- pixel buffer --

(defun make-pbuf ()
  (make-array (list *ph* *pw*) :initial-element 0))

(defun pbuf-set (buf x y ci)
  (when (and (>= x 0) (< x *pw*) (>= y 0) (< y *ph*))
    (setf (aref buf y x) ci)))

; -- scanline polygon fill --

(defun fill-poly (buf pts ci)
  (when (< (length pts) 3) (return-from fill-poly))
  (let* ((ys (mapcar #'cdr pts))
         (y1 (max 0          (apply #'min ys)))
         (y2 (min (1- *ph*)  (apply #'max ys)))
         (n  (length pts)))
    (loop for y from y1 to y2 do
      (let (xs)
        (dotimes (i n)
          (let* ((a  (nth i pts))
                 (b  (nth (mod (1+ i) n) pts))
                 (ay (cdr a)) (by (cdr b))
                 (ax (car a)) (bx (car b)))
            (when (or (and (<= ay y) (< y by))
                      (and (<= by y) (< y ay)))
              (let ((frac (/ (float (- y ay)) (- by ay))))
                (push (round (+ ax (* frac (- bx ax)))) xs)))))
        (when (>= (length xs) 2)
          (loop for x from (max 0         (apply #'min xs))
                        to (min (1- *pw*) (apply #'max xs)) do
            (pbuf-set buf x y ci)))))))

; -- background and floor --

(defun fill-background (buf)
  (dotimes (y *ph*)
    (dotimes (x *pw*)
      (setf (aref buf y x) 0))))

(defun draw-floor (buf)
  ; flat parallelogram at z=0 covering the world footprint
  (fill-poly buf
             (list (iso-pt    0   0 0) (iso-pt 1100    0 0)
                   (iso-pt 1100 1100 0) (iso-pt    0 1100 0))
             1))

; -- isometric block drawing --
;
; Viewer is at small wx, small wy, large wz.
; Visible faces are those whose outward normal points toward viewer:
;   x-min face (wx1) → LEFT  parallelogram on screen  (medium shade, ci-l)
;   y-min face (wy1) → RIGHT parallelogram on screen  (dark shade,   ci-r)
;   z-max face (wz2) → TOP   diamond on screen        (light shade,  ci-t)
;
; Draw order: left, front, top — top overwrites any shared-edge pixels.

(defun draw-block-iso (buf wx1 wy1 wz1 wx2 wy2 wz2 color-sym)
  (destructuring-bind (ci-t ci-l ci-r) (color-indices color-sym)
    (let ((p000 (iso-pt wx1 wy1 wz1))
          (p100 (iso-pt wx2 wy1 wz1))
          (p010 (iso-pt wx1 wy2 wz1))
          (p001 (iso-pt wx1 wy1 wz2))
          (p101 (iso-pt wx2 wy1 wz2))
          (p011 (iso-pt wx1 wy2 wz2))
          (p111 (iso-pt wx2 wy2 wz2)))
      (fill-poly buf (list p000 p010 p011 p001) ci-l)  ; left  face (x-min)
      (fill-poly buf (list p000 p100 p101 p001) ci-r)  ; front face (y-min)
      (fill-poly buf (list p001 p101 p111 p011) ci-t)  ; top   face (z-max)
      )))

; -- isometric pyramid drawing --
;
; Square base at wz1, apex at center of base footprint at wz2.
; Visible faces from this viewpoint:
;   x-min triangle: p000, p010, apex  (left face,  medium shade)
;   y-min triangle: p000, p100, apex  (front face, dark shade)

(defun draw-pyramid-iso (buf wx1 wy1 wz1 wx2 wy2 wz2 color-sym)
  (destructuring-bind (ci-t ci-l ci-r) (color-indices color-sym)
    (declare (ignore ci-t))
    (let* ((wmx (/ (+ wx1 wx2) 2.0))
           (wmy (/ (+ wy1 wy2) 2.0))
           (p000 (iso-pt wx1 wy1 wz1))
           (p100 (iso-pt wx2 wy1 wz1))
           (p010 (iso-pt wx1 wy2 wz1))
           (apex (iso-pt wmx wmy wz2)))
      (fill-poly buf (list p000 p010 apex) ci-l)  ; left  face (x-min)
      (fill-poly buf (list p000 p100 apex) ci-r)  ; front face (y-min)
      )))

; -- Sixel encoder --

(defun emit-sixel (buf)
  (let* ((esc   (code-char 27))
         (bands (/ *ph* 6)))
    (write-char esc) (format t "P0;0;0q")
    (format t "\"1;1;~a;~a" *pw* *ph*)
    (loop for i from 0 below (length *sixel-palette*) do
      (let ((c (aref *sixel-palette* i)))
        (format t "#~a;2;~a;~a;~a" i (first c) (second c) (third c))))
    (loop for band from 0 below bands do
      (let* ((y0   (* band 6))
             (used (let (acc)
                     (loop for y from y0 below (+ y0 6) do
                       (loop for x from 0 below *pw* do
                         (pushnew (aref buf y x) acc)))
                     (sort acc #'<)))
             (first-in-band t))
        (dolist (ci used)
          (unless first-in-band (write-char #\$))
          (setq first-in-band nil)
          (format t "#~a" ci)
          (let ((run-ch  nil)
                (run-len 0))
            (flet ((flush-run ()
                     (when run-ch
                       (if (> run-len 3)
                           (format t "!~a~c" run-len (code-char run-ch))
                           (loop repeat run-len
                                 do (write-char (code-char run-ch)))))))
              (loop for x from 0 below *pw* do
                (let ((bits 0))
                  (loop for dy from 0 below 6 do
                    (when (= (aref buf (+ y0 dy) x) ci)
                      (setf bits (logior bits (ash 1 dy)))))
                  (let ((ch (+ 63 bits)))
                    (cond ((eql ch run-ch) (incf run-len))
                          (t (flush-run)
                             (setq run-ch ch run-len 1))))))
              (flush-run))))
        (write-char #\-)))
    (write-char esc) (write-char #\\))
  (finish-output))

; -- MOVER intercepts (capture *last-action* for status line) --

(let ((orig-moveto  (symbol-function 'moveto))
      (orig-grasp   (symbol-function 'grasp))
      (orig-ungrasp (symbol-function 'ungrasp))
      (orig-blink   (symbol-function 'blink)))
  (defun moveto (x y z)
    (setq *last-action* (format nil "moving hand to (~a ~a ~a)" x y z))
    (funcall orig-moveto x y z))
  (defun grasp (x)
    (setq *last-action* (format nil "grasping ~a" x))
    (funcall orig-grasp x))
  (defun ungrasp ()
    (setq *last-action* "letting go")
    (funcall orig-ungrasp))
  (defun blink (x)
    (setq *last-action* (format nil "choosing ~a" x))
    (funcall orig-blink x)))

; -- main entry point --

(defun render-world ()
  (let ((buf (make-pbuf)))
    (fill-background buf)
    (draw-floor buf)
    ; sort descending by (wx+wy): draw farthest-from-viewer blocks first
    (dolist (entry (sort (copy-list atable)
                         #'> :key (lambda (e)
                                    (let ((p (cadr e)))
                                      (+ (car p) (cadr p))))))
      (let* ((name (car   entry))
             (pos  (cadr  entry))
             (size (caddr entry)))
        (unless (sixel-skip-p name)
          (let* ((wx1 (car   pos))  (wy1 (cadr  pos))  (wz1 (caddr pos))
                 (wx2 (+ wx1 (car   size)))
                 (wy2 (+ wy1 (cadr  size)))
                 (wz2 (+ wz1 (caddr size)))
                 (color (or (sixel-color name) 'WHITE))
                 (shape (sixel-shape name)))
            (if (eq shape '\#PYRAMID)
                (draw-pyramid-iso buf wx1 wy1 wz1 wx2 wy2 wz2 color)
                (draw-block-iso   buf wx1 wy1 wz1 wx2 wy2 wz2 color)))))
    (format t "~c[2J~c[H" (code-char 27) (code-char 27))
    (emit-sixel buf)
    (terpri)
    (when (> (length *last-action*) 0)
      (format t "~a~%" *last-action*)))
  (finish-output))
