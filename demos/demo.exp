#!/usr/bin/expect
# Source: "Conversation with SHRDLU" by Terry Winograd, 1970 Boston lecture (Prof. Ben-Avi), entries 1–44

set timeout 120
set send_human {.02 .08 .3 .01 .5}

# type_human: print each character to our terminal and send it to the process.
# readline runs in raw mode and echoes independently of PTY stty settings, so
# we suppress expect's own output mirroring (log_user 0) and consume readline's
# echo manually — one char per keystroke, one newline after \r.
proc type_human {text} {
    log_user 0
    foreach char [split $text {}] {
        if {$char eq "\r"} {
            puts ""
            flush stdout
            send -- $char
            expect -timeout 1 -re "\r?\n" {}
        } else {
            puts -nonewline $char
            flush stdout
            send -- $char
            expect -timeout 1 -re "." {}
        }
        after [expr {20 + int(rand() * 250)}]
    }
    log_user 1
}

spawn clisp LOADER
stty -echo

expect "READY"
sleep 2

type_human "Pick up a big red block.\r"
expect "READY"
sleep 2

type_human "Grasp the pyramid.\r"
expect "READY"
sleep 2

type_human "Find a block which is taller than the one you are holding and put it into the box.\r"
expect "READY"
sleep 2

type_human "What does the box contain?\r"
expect "READY"
sleep 2

type_human "What is the pyramid supported by?\r"
expect "READY"
sleep 2

type_human "How many blocks are not in the box?\r"
expect "READY"
sleep 2

type_human "Is at least one of them narrower than the one which i told you to pick up?\r"
expect "READY"
sleep 2

type_human "Is it supported?\r"
expect "READY"
sleep 2

type_human "Can the table pick up blocks?\r"
expect "READY"
sleep 2

type_human "Can a pyramid be supported by a block?\r"
expect "READY"
sleep 2

type_human "Can a pyramid support a pyramid?\r"
expect "READY"
sleep 2

type_human "Stack up two pyramids.\r"
expect "READY"
sleep 2

type_human "The blue pyramid is nice.\r"
expect "READY"
sleep 2

type_human "I like blocks which are not red, but I don't like anything which supports a pyramid.\r"
expect "READY"
sleep 2

type_human "Do I like the box?\r"
expect "READY"
sleep 2

type_human "Do I like anything in the box?\r"
expect "READY"
sleep 2

type_human "Will you please stack up both of the red blocks and either a green cube or a pyramid?\r"
expect "READY"
sleep 2

type_human "Which cube is sitting on the table?\r"
expect "READY"
sleep 2

type_human "Is there a large block behind a pyramid?\r"
expect "READY"
sleep 2

type_human "Put a small one onto the green cube which supports a pyramid.\r"
expect "READY"
sleep 2

type_human "Put the littlest pyramid on top of it.\r"
expect "READY"
sleep 2

type_human "Does the shortest thing the tallest pyramid's support supports support anything green?\r"
expect "READY"
sleep 2

type_human "What color is it?\r"
expect "READY"
sleep 2

# Disambiguation: SHRDLU asks 1 or 2 before printing READY
type_human "How many things are on top of green cubes?\r"
expect "2 "
type_human "2\r"
expect "READY"
sleep 2

type_human "Had you touched any pyramid before you put the green one on the little cube?\r"
expect "READY"
sleep 2

type_human "When did you pick it up?\r"
expect "READY"
sleep 2

type_human "Why?\r"
expect "READY"
sleep 2

type_human "Why did you do that?\r"
expect "READY"
sleep 2

type_human "Why did you clear off that cube?\r"
expect "READY"
sleep 2

type_human "Why did you do that?\r"
expect "READY"
sleep 2

type_human "Why did you do that?\r"
expect "READY"
sleep 2

type_human "How did you do it?\r"
expect "READY"
sleep 2

type_human "How many objects did you touch while you were doing it?\r"
expect "READY"
sleep 2

type_human "What did the red cube support before you started to clean it off?\r"
expect "READY"
sleep 2

type_human "There were five blocks to the left of the box then.\r"
expect "READY"
sleep 2

type_human "Put the blue pyramid on the block in the box.\r"
expect "READY"
sleep 2

type_human "Is there anything which is bigger than every pyramid but is not as wide as the thing that supports it?\r"
expect "READY"
sleep 2

# Original ITS: SHRDLU interrupted before Enter on "steeple". Readline buffers
# the full line, so we must terminate with '?' because SHRDLU only parses on
# sentence-end punctuation. The truncated-sentence effect is lost, but the
# unknown-word response is preserved.
type_human "Does a steeple?\r"
expect "READY"
sleep 2

type_human "A \"steeple\" is a stack which contains two green cubes and a pyramid.\r"
expect "READY"
sleep 2

type_human "Are there any steeples now?\r"
expect "READY"
sleep 2

type_human "Build one.\r"
expect "READY"
sleep 2

type_human "Call the biggest block \"superblock\".\r"
expect "READY"
sleep 2

type_human "Have you picked superblock up since we began?\r"
expect "READY"
sleep 2

type_human "Why did you drop it?\r"
expect "READY"
sleep 2

type_human "Is there anything to the right of the red pyramid?\r"
expect "READY"
sleep 2

type_human "Thank you.\r"
expect "WELCOME"

interact
